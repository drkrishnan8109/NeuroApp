# Paste this into the Streamlit Community Cloud app settings under "Secrets"
# (Manage app -> Settings -> Secrets), with your real values.
#
# Do NOT commit a filled-in copy: .streamlit/secrets.toml is gitignored.

# Required — the deployed app embeds queries through the HF Inference API,
# because BAAI/bge-m3 (2.3 GB) does not fit the container.
HF_TOKEN = ""

# Required — the dense vector index.
PINECONE_API_KEY = ""

# Generation. Ollama is unreachable from a container, so the app falls through
# to these. At least one is needed.
MISTRAL_API_KEY = ""
GOOGLE_API_KEY = ""

# Optional — tracing.
LANGSMITH_API_KEY = ""
LANGSMITH_TRACING = "true"

# Ollama cannot run in a container; list only the hosted generators.
RAG_GENERATORS = "mistralai:mistral-small-latest,google_genai:gemini-flash-latest"
