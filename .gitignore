# --- Secrets -----------------------------------------------------------------
# .env holds 8 live API keys. Committing it writes them into git history
# permanently — a later `git rm` does not remove them from earlier commits, and
# pushing even once means every key must be rotated. Use .env.example as the
# tracked template and keep the real file local.
.env

# --- Corpus and derived data -------------------------------------------------
# pdfs/ (162 MB) and data/ (362 MB) ARE tracked, via Git LFS — see .gitattributes.
# Two files exceed GitHub's 100 MB per-file limit and cannot be stored any other
# way: data/vector_store/chroma.sqlite3 (286 MB) and Bradley's PDF (117 MB).
#
# Note LFS keeps every version of a tracked file. Re-running ingestion rewrites
# chroma.sqlite3, and each commit of it adds another ~286 MB against the 1 GB
# free-tier storage quota.

# --- Python ------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
*.egg-info/

# Streamlit secrets (real values live in the Cloud UI, never in the repo)
.streamlit/secrets.toml
